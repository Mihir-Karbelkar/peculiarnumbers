---
import SiteLayout from '../components/Layout/SiteLayout.astro';
import TwinPrimeExplorer from '../components/Grid/TwinPrimeExplorer';
---
<SiteLayout title="Twin Prime Window Explorer | Peculiar Numbers">
  <section class="py-12">
    <p class="mb-3 text-sm uppercase tracking-[0.3em] text-sky-300">experiment 001</p>
    <h1 class="font-serif text-5xl md:text-7xl">Twin Prime Window Explorer</h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-300">Generate weighted windows of twin-prime pairs. Each pair contributes exactly one unit, split across every row it touches, so the first column remains a conserved count.</p>
  </section>
  <TwinPrimeExplorer client:load />
</SiteLayout>
